# -----------------------------
# Server & App Configuration
# -----------------------------
VITE_PORT=5173               # Port for local development
VITE_BASE_URL=/              # Base URL for the app

# -----------------------------
# API Configuration
# -----------------------------
VITE_API_URL=https://api.example.com   # Base URL of your backend API
VITE_API_KEY=your-api-key-here         # API key for authentication (if required)

# -----------------------------
# Feature Flags / Mock Data
# -----------------------------
VITE_USE_MOCK_API=true        # true = use mock API, false = use real API
VITE_ENABLE_ANALYTICS=false   # true = enable analytics, false = disable

# -----------------------------
# Optional / Development
# -----------------------------
VITE_DEBUG_MODE=true           # true = verbose logging for dev
